[Unit]
Description=Cloudflare Tunnel to the BAR Rewind server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/bar-rewind/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5
DynamicUser=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
